@model RestauranteWeb.Models.TipoRestauranteViewModel

@{
    ViewData["Title"] = "Editar tipo de restaurante";
}

<section>
    <h1>Editar tipo de restaurante</h1>
</section>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" maxlength="50" />
        <span asp-validation-for="Nome"></span>
    </p>
    <nav>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline">Voltar</a>
    </nav>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
