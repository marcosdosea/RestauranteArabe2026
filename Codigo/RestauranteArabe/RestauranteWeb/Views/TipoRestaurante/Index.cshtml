@model IEnumerable<RestauranteWeb.Models.TipoRestauranteViewModel>

@{
    ViewData["Title"] = "Tipos de restaurante";
}

<h1>Tipos de restaurante</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo tipo de restaurante</a>
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tipoRestaurante in Model)
        {
            <tr>
                <td>@tipoRestaurante.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@tipoRestaurante.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@tipoRestaurante.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>