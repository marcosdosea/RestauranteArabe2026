@model RestauranteWeb.Models.TipoFuncionarioModel

@{
    ViewData["Title"] = "Excluir Tipo de Funcionário";
}

<section>
    <h1>Excluir tipo de funcionário</h1>
</section>

<p>Deseja excluir o tipo de funcionário <strong>@Model.Nome</strong>?</p>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <nav>
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-outline">Cancelar</a>
    </nav>
</form>