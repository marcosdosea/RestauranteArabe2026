@model RestauranteWeb.Models.TipoFuncionarioModel

@{
    ViewData["Title"] = "Excluir Tipo de Funcionário";
}

<h1>Excluir Tipo de Funcionário</h1>

<h3>Tem certeza que deseja excluir o tipo <strong>@Html.DisplayFor(model => model.Nome)</strong>?</h3>
<div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-primary">Cancelar</a>
    </form>
</div>
