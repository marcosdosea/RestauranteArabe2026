@model IEnumerable<RestauranteWeb.Models.TipoFuncionarioModel>

@{
    ViewData["Title"] = "Tipos de Funcionário";
}

<section>
    <div>
        <h1>Tipos de Funcionário</h1>
        <p>Funções atribuídas a cada funcionário.</p>
    </div>
    <a asp-action="Create" class="btn btn-secondary">+ Novo tipo de funcionário</a>
</section>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @if(!Model.Any())
        {
            <tr>
                <td colspan="3">Nenhum tipo de funcionário cadastrado.</td>
            </tr>
        }
        else
        {
            @foreach(var tipoFuncionario in Model)
            {
                <tr>
                    <td>@tipoFuncionario.Id</td>
                    <td>@tipoFuncionario.Nome</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@tipoFuncionario.Id">Detalhes</a> |
                        <a asp-action="Edit" asp-route-id="@tipoFuncionario.Id">Editar</a> |                 
                        <a asp-action="Delete" asp-route-id="@tipoFuncionario.Id">Excluir</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
