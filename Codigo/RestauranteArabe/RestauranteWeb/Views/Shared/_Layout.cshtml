<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestauranteWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestauranteWeb.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <button id="menu-toggle" aria-label="Abrir ou fechar menu">
            <img src="img/menu-icon.svg" alt="" width="40" height="40"/>
        </button>
    </header>

    <aside>
        <a href="/">Mesa</a>
        <nav>
            <ul>
                <li>
                    <a href="">
                        <img src="img/dashboard-icon.svg" alt="" width="20" height="20">
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="">
                        <img src="img/store-icon.svg" alt="" width="20" height="20">
                        <span>Restaurantes</span>
                    </a>
                </li>
                <li>
                    <a href="">
                        <img src="img/employees-icon.svg" alt="" width="20" height="20">
                        <span>Funcionários</span>
                    </a>
                </li>
                <li>
                    <a href="">
                        <img src="img/utensils-icon.svg" alt="" width="20" height="20">
                        <span>Cardápio</span>
                    </a>
                </li>
                <li>
                    <a href="">
                        <img src="img/grid-icon.svg" alt="" width="20" height="20">
                        <span>Mesas</span>
                    </a>
                </li>
                <li>
                    <a href="">
                        <img src="img/receipt-text-icon.svg" alt="" width="20" height="20">
                        <span>Atendimentos</span>
                    </a>
                </li>
                <li>
                    <a href="" id="submenu-toggle" data-bs-toggle="collapse" data-bs-target="#submenu-cadastros" aria-expanded="false" aria-controls="submenu-cadastros">
                        <img src="img/folder-open-icon.svg" alt="" width="20" height="20">
                        <span>Cadastros</span>
                    </a>
                    <ul id="submenu-cadastros" class="collapse">
                        <li><a href="">Formas de Pagamento</a></li>
                        <li><a href="">Tipos de Restaurante</a></li>
                        <li><a href="">Tipos de Funcionário</a></li>
                        <li><a href="">Grupos do Cardápio</a></li>
                    </ul>
                </li>
            </ul>
        </nav>
    </aside>

    <main>
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
