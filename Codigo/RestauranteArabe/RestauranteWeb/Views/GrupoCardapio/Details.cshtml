@model RestauranteWeb.Models.GrupoCardapioViewModel

@{
    ViewData["Title"] = "Detalhes do grupo";
}

<div class="page-header">
    <h1>Detalhes do grupo</h1>
</div>

<dl class="data-list">
    <dt>@Html.DisplayNameFor(model => model.Id)</dt>
    <dd>@Html.DisplayFor(model => model.Id)</dd>
    <dt>@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd>@Html.DisplayFor(model => model.Nome)</dd>
</dl>

<div class="form-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>
