@model RestauranteWeb.Models.GrupoCardapioViewModel

@{
    ViewData["Title"] = "Novo grupo do cardápio";
}

<section>
    <h1>Novo grupo do cardápio</h1>
</section>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" maxlength="50" />
        <span asp-validation-for="Nome"></span>
    </p>
    <nav>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline">Voltar</a>
    </nav>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
