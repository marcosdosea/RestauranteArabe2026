@model IEnumerable<RestauranteWeb.Models.GrupoCardapioViewModel>

@{
    ViewData["Title"] = "Grupos do Cardápio";
}

<section>
    <div>
        <h1>Grupos do Cardápio</h1>
        <p>Categorias que deixam o cardápio simples de navegar.</p>
    </div>
    <a asp-action="Create" class="btn btn-secondary">+ Novo grupo</a>
</section>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="3">Nenhum grupo cadastrado.</td>
            </tr>
        }
        else
        {
            @foreach (var grupoCardapio in Model)
            {
                <tr>
                    <td>@grupoCardapio.Id</td>
                    <td>@grupoCardapio.Nome</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@grupoCardapio.Id">Detalhes</a>
                        |
                        <a asp-action="Edit" asp-route-id="@grupoCardapio.Id">Editar</a>
                        |
                        <a asp-action="Delete" asp-route-id="@grupoCardapio.Id">Excluir</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
