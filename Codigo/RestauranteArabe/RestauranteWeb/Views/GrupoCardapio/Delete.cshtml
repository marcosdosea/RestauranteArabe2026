@model RestauranteWeb.Models.GrupoCardapioViewModel

@{
    ViewData["Title"] = "Excluir grupo do cardápio";
}

<section>
    <h1>Excluir grupo do cardápio</h1>
</section>

<p>Deseja excluir o grupo do cardápio <strong>@Model.Nome</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <nav>
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-outline">Cancelar</a>
    </nav>
</form>
