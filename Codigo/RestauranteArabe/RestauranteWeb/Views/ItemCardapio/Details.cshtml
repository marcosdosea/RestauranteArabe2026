@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    ViewData["Title"] = "Detalhes do item do cardápio";
}

<section>
    <h1>Detalhes do item do cardápio</h1>
</section>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nome)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Nome)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.NomeGrupoCardapio)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.NomeGrupoCardapio)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Preco)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Preco)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.NomeRestaurante)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.NomeRestaurante)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Detalhes)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Detalhes)</dd>

    <dt class="col-sm-2">Situação</dt>
    <dd class="col-sm-10">@(Model.Ativo == 1 ? "Ativo" : "Inativo")</dd>
</dl>

<nav>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-outline">Voltar</a>
</nav>