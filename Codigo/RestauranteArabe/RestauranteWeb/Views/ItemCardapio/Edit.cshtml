@model RestauranteWeb.Models.ItemCardapioViewModel

@{
    ViewData["Title"] = "Editar item do cardápio";
}

<section>
    <h1>Editar item do cardápio</h1>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>
    <p>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" maxlength="30" />
        <span asp-validation-for="Nome"></span>
    </p>
    <p>
        <label asp-for="IdGrupoCardapio"></label>
        <select asp-for="IdGrupoCardapio" asp-items="Model.ListaGruposCardapio">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="IdGrupoCardapio"></span>
    </p>
    <p>
        <label asp-for="Preco"></label>
        <input asp-for="Preco" type="number" step="0.01" />
        <span asp-validation-for="Preco"></span>
    </p>
    <p>
        <label asp-for="IdRestaurante"></label>
        <select asp-for="IdRestaurante" asp-items="Model.ListaRestaurantes">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="IdRestaurante"></span>
    </p>
    <p>
        <label asp-for="Detalhes"></label>
        <input asp-for="Detalhes" maxlength="200" />
        <span asp-validation-for="Detalhes"></span>
    </p>
    <p>
        <label asp-for="Ativo"></label>
        <select asp-for="Ativo">
            <option value="1">Ativo</option>
            <option value="0">Inativo</option>
        </select>
    </p>
    <nav>
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline">Voltar</a>
    </nav>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}