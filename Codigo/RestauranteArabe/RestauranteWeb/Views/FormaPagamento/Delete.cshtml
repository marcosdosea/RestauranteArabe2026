@model RestauranteWeb.Models.FormaPagamentoViewModel

@{
    ViewData["Title"] = "Excluir forma de pagamento";
}

<section>
    <h1>Excluir forma de pagamento</h1>
</section>

<p>Deseja excluir a forma de pagamento <strong>@Model.Nome</strong>?</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <nav>
        <button type="submit" class="btn btn-danger">Excluir</button>
        <a asp-action="Index" class="btn btn-outline">Cancelar</a>
    </nav>
</form>
