@model IEnumerable<RestauranteWeb.Models.FormaPagamentoViewModel>

@{
    ViewData["Title"] = "Formas de pagamento";
}

<h1>Formas de pagamento</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Nova forma de pagamento</a>
</p>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var formaPagamento in Model)
        {
            <tr>
                <td>@formaPagamento.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@formaPagamento.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@formaPagamento.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>